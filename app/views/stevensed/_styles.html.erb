<%# StevensED public pages: brand type and tokens (stevensed.org, policies.stevensed.org). Fonts: OFL, self-hosted. %>
<% unless content_for?(:stevensed_styles) %>
<% content_for(:stevensed_styles, 'loaded') %>
<% content_for :head do %>
  <link rel="preload" href="/stevensed/fonts/cormorant-garamond-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/stevensed/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <style>
    @font-face { font-family: 'Cormorant Garamond'; src: url('/stevensed/fonts/cormorant-garamond-latin-wght-normal.woff2') format('woff2'); font-weight: 300 700; font-display: swap; }
    @font-face { font-family: 'Inter'; src: url('/stevensed/fonts/inter-latin-wght-normal.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
    .se { --navy: #2f3e68; --navy-deep: #26335a; --ink: #1f2948; --text: #3a4461; --muted: #59697a; --crimson: #c13f44; --cream: #f7f5f1; --parchment: #e9e3d8; --rule: #d8d0c1;
      background: var(--cream); color: var(--text); font-family: 'Inter', ui-sans-serif, system-ui, sans-serif; font-size: 1.0625rem; line-height: 1.65; min-height: 100dvh; display: flex; flex-direction: column;
      -webkit-font-smoothing: antialiased; font-feature-settings: 'cv11', 'ss01'; caret-color: var(--crimson); }
    .se-site-header, .se-site-footer { --navy: #2f3e68; --navy-deep: #26335a; --ink: #1f2948; --text: #3a4461; --muted: #59697a; --crimson: #c13f44; --cream: #f7f5f1; --rule: #d8d0c1; font-family: 'Inter', ui-sans-serif, system-ui, sans-serif; }
    .se-site-header .se-wrap, .se-site-footer .se-wrap { width: 100%; max-width: 76rem; margin-inline: auto; padding-inline: 1.5rem; }
    .se-app-header { margin-bottom: 1.5rem; }
    .se-site-header.se-site-header--static { position: relative; margin-bottom: 0; }
    .se-site-header .se-wrap.se-wrap--wide { max-width: 100rem; }
    .se-page-zone { display: flex; align-items: center; gap: 1rem; flex: 1 1 auto; min-width: 0; }
    .se-page-zone__rule { width: 1px; height: 2.25rem; background: var(--rule); flex: none; }
    .se-page-zone__title { flex: 1 1 auto; min-width: 0; }
    .se-page-zone__title, .se-page-zone__title a:not(.btn):not(.white-button):not(.base-button) { display: block; color: var(--ink); text-decoration: none; }
    .se-page-zone__title h1, .se-page-zone__title .se-page-title { font-size: 1.125rem; font-weight: 600; line-height: 1.3; letter-spacing: -0.005em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; }
    .se-page-zone__title .se-page-subtitle { display: block; font-size: 0.8125rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .se-page-zone__actions { display: flex; align-items: center; gap: 0.5rem; flex: none; }
    .se-page-zone__actions :is(.white-button, .base-button, .btn) { height: 2.5rem; min-height: 2.5rem; padding-inline: 1rem; font-size: 0.9375rem; text-transform: none; letter-spacing: 0; font-weight: 600; }
    .se-page-zone__actions .white-button { border-width: 1px; border-color: var(--navy); color: var(--navy); background: #fff; }
    .se-page-zone__actions .base-button, .se-page-zone__actions .btn-neutral { background: var(--navy); border-color: var(--navy); color: #fff; }
    .se-nav--hidden { display: none !important; }
    .se-builder-header { display: flex; align-items: center; min-width: 0; }
    /* Guided signing */
    .se-signing-progress { font-size: 0.8125rem; color: var(--muted, #59697a); white-space: nowrap; }
    .se-finish:empty { display: none; }
    .se-finish .btn, .se-finish button { background: #c13f44 !important; border-color: #c13f44 !important; color: #fff !important; border-radius: 999px; padding-inline: 1.5rem !important; height: 2.5rem; min-height: 2.5rem; font-size: 0.9375rem; font-weight: 600; text-transform: none; opacity: 1; }
    .se-finish .btn-disabled { background: #fff !important; color: #c13f44 !important; }
    .se-finish .tooltip::before { font-size: 0.8125rem; }
    .se-other-actions { height: 2.5rem; min-height: 2.5rem; border-radius: 999px; border: 1px solid #2f3e68; background: #fff; color: #2f3e68; font-size: 0.9375rem; font-weight: 600; text-transform: none; padding-inline: 1rem; gap: 0.35rem; }
    .se-other-actions:hover { background: #f1eee7; border-color: #2f3e68; }
    .se-other-actions__menu { min-width: 15rem; font-size: 0.9375rem; color: #1f2948; font-family: 'Inter', ui-sans-serif, system-ui, sans-serif; }
    .se-guide-tag { position: absolute; right: calc(100% + 14px); z-index: 30; transform: translateY(-20%); display: inline-flex; align-items: center; height: 2.25rem; padding: 0 0.6rem 0 0.9rem; background: #c13f44; color: #fff; font: 600 0.875rem/1 'Inter', ui-sans-serif, system-ui, sans-serif; letter-spacing: 0.02em; text-transform: uppercase; border-radius: 4px 0 0 4px; box-shadow: 0 2px 8px #1f294833; cursor: pointer; animation: se-guide-nudge 1.8s ease-in-out infinite; }
    .se-guide-tag::after { content: ''; position: absolute; left: 100%; top: 0; border-style: solid; border-width: 1.125rem 0 1.125rem 0.75rem; border-color: transparent transparent transparent #c13f44; }
    .se-guide-tag:hover { background: #9a2d33; }
    .se-guide-tag:hover::after { border-left-color: #9a2d33; }
    .se-guide-tag:focus-visible { outline: 3px solid #2f3e68; outline-offset: 3px; }
    @keyframes se-guide-nudge { 0%, 100% { translate: 0 0; } 50% { translate: 6px 0; } }
    @media (prefers-reduced-motion: reduce) { .se-guide-tag { animation: none; } }
    @media (max-width: 1229px) { .se-guide-tag { right: auto; left: 0; transform: translate(0, -20%); border-radius: 0 4px 4px 0; padding-left: 0.6rem; } }
    @media (max-width: 767px) { .se-guide-tag { display: none; } }
    @media (max-width: 767px) { .se-signing-progress, .se-page-zone__title .se-page-subtitle { display: none; } .se-page-zone__rule { display: none; } .se-page-zone__title h1, .se-page-zone__title .se-page-title { font-size: 1rem; } }
    @media (max-width: 560px) { .se-other-actions__label { display: none; } .se-other-actions { padding-inline: 0.6rem; } }
    /* ESIGN consent */
    html.se-gate-open { overflow: hidden; }
    .se-gate { --navy: #2f3e68; --navy-deep: #26335a; --ink: #1f2948; --crimson: #c13f44; --cream: #f7f5f1; position: fixed; inset: 0; z-index: 70; display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto; place-items: center; padding: 1rem; background: #1f2948a6; backdrop-filter: blur(2px); font-family: 'Inter', ui-sans-serif, system-ui, sans-serif; color: #3a4461; }
    .se-gate__card { width: 100%; max-width: 34rem; background: #f7f5f1; border-radius: 12px; border-top: 4px solid #c13f44; padding: 2rem 2rem 1.5rem; box-shadow: 0 20px 50px #1f294859; }
    .se-gate__eyebrow { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #c13f44; margin: 0 0 0.5rem; }
    .se-gate__title { font-family: 'Cormorant Garamond', ui-serif, Georgia, serif; font-size: 1.875rem; font-weight: 600; line-height: 1.15; color: #1f2948; margin: 0 0 0.35rem; }
    .se-gate__doc { font-weight: 600; color: #2f3e68; margin: 0 0 1rem; }
    .se-gate__text { font-size: 0.9375rem; line-height: 1.6; margin: 0 0 1.25rem; }
    .se-gate__text a, .se-gate__note a { color: #2f3e68; text-decoration: underline; text-underline-offset: 0.2em; }
    .se-gate__check { display: flex; gap: 0.75rem; align-items: flex-start; padding: 0.9rem 1rem; background: #fff; border: 1px solid #d8d0c1; border-radius: 8px; font-weight: 600; color: #1f2948; cursor: pointer; }
    .se-gate__check input { width: 1.25rem; height: 1.25rem; margin-top: 0.1rem; accent-color: #2f3e68; flex: none; }
    .se-gate__error { margin: 0.75rem 0 0; color: #9a2d33; font-size: 0.875rem; }
    .se-gate__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 1.25rem; }
    .se-gate .se-gate__continue { height: 2.75rem; padding-inline: 2rem; border: 0; cursor: pointer; }
    .se-gate .se-gate__continue:disabled { opacity: 0.45; cursor: not-allowed; }
    .se-gate__decline { background: none; border: 0; color: #2f3e68; font-weight: 600; text-decoration: underline; text-underline-offset: 0.2em; cursor: pointer; }
    .se-gate__form { margin: 0; }
    .se-gate .se-gate__continue:hover:not(:disabled) { background: var(--navy-deep); color: #fff !important; }
    .se-gate .se-gate__continue:disabled:hover { background: var(--navy); box-shadow: none; }
    .se-gate__text a, .se-gate__note a { color: var(--navy); text-decoration: underline; text-underline-offset: 0.2em; }
    .se-gate__text a:hover, .se-gate__note a:hover, .se-gate__link:hover { color: var(--navy-deep); text-decoration-thickness: 2px; }
    .se-gate__field { display: grid; gap: 0.4rem; font-weight: 600; color: #1f2948; }
    .se-gate__field input { height: 2.75rem; padding: 0 0.85rem; border: 1px solid #d8d0c1; border-radius: 8px; background: #fff; font: inherit; font-weight: 500; color: #1f2948; max-width: 16rem; }
    .se-gate__field input:focus-visible { outline: 3px solid #2f3e68; outline-offset: 2px; }
    .se-gate__secondary { display: flex; flex-wrap: wrap; gap: 1.25rem; margin-top: 1rem; }
    .se-gate__link { background: none; border: 0; padding: 0; color: #2f3e68; font-weight: 600; text-decoration: underline; text-underline-offset: 0.2em; cursor: pointer; font-size: 0.9375rem; }
    .se-gate__message { margin: 1rem 0 0; padding: 0.9rem 1rem; background: #fff; border-left: 3px solid #2f3e68; border-radius: 4px; color: #1f2948; }
    .se-gate__text strong { color: #1f2948; }
    .se-gate__note { font-size: 0.8125rem; color: #59697a; margin: 1.25rem 0 0; }
    .se-builder-header .template-name { font-size: 1.125rem !important; line-height: 1.3; font-weight: 600; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .se-builder-header :is(.btn, .white-button, .base-button) { height: 2.5rem; min-height: 2.5rem; padding-inline: 1rem; font-size: 0.9375rem; text-transform: none; letter-spacing: 0; font-weight: 600; }
    @media (max-width: 900px) { .se-page-zone ~ * .se-brand__text, .se-site-header__inner:has(.se-page-zone) .se-brand__text { display: none; } }
    .se-app-main { min-height: calc(100dvh - 26rem); }
    /* Settings pages (every page that renders shared/settings_nav): one content column with one left edge and width,
       controls in sentence case and sized to their label. Radius scale: surfaces 12px, fields 8px, buttons pill. */
    main:has(#account_settings_menu) { --btn-text-case: none; --rounded-box: 0.75rem; --se-edge: #ddd5c6; --se-field-edge: #7b8597; }
    main > div > div:has(> #account_settings_menu) + div { flex: 1 1 100%; min-width: 0; width: 100%; max-width: 48rem; margin-left: 0; margin-right: 0; }
    main > div > div:has(> #account_settings_menu) + div + div:empty { display: none; }
    main > div > div:has(> #account_settings_menu) + div > h1 + p { max-width: 75ch; margin-top: -0.25rem; margin-bottom: 1.75rem; color: #3a4461; }
    main > div > div:has(> #account_settings_menu) + div :is(h2.text-2xl, h2.text-3xl, p.text-2xl.font-bold) { font-size: 1.5rem; line-height: 1.3; font-weight: 700; letter-spacing: -0.01em; }
    main > div > div:has(> #account_settings_menu) + div :is(.base-button, .white-button) { width: auto; height: 2.75rem; min-height: 2.75rem; padding-inline: 1.25rem; gap: 0.5rem; font-size: 0.9375rem; font-weight: 600; letter-spacing: 0; }
    main > div > div:has(> #account_settings_menu) + div .white-button { border-width: 1px; border-color: #2f3e68; color: #2f3e68; }
    main > div > div:has(> #account_settings_menu) + div .white-button:hover { background: #f1eee7; border-color: #26335a; color: #26335a; }
    main > div > div:has(> #account_settings_menu) + div .form-control > :is(.base-button, .white-button) { align-self: flex-start; }
    main > div > div:has(> #account_settings_menu) + div :is(.input, .select, .textarea, .file-input, .base-input, .base-select, .base-textarea) { border-radius: 0.5rem; border-color: var(--se-field-edge); }
    main > div > div:has(> #account_settings_menu) + div :is(.input, .select):not([class*="-sm"]):not([class*="-xs"]) { height: 2.75rem; min-height: 2.75rem; }
    main > div > div:has(> #account_settings_menu) + div :is(.input, .select, .textarea, .base-input, .base-select, .base-textarea):focus { outline: 2px solid #2f3e68; outline-offset: 2px; }
    main > div > div:has(> #account_settings_menu) + div :is(.card, .collapse).bg-base-200,
    main > div > div:has(> #account_settings_menu) + div .bg-base-200:is(.rounded-xl, .rounded-2xl, .rounded-3xl) { background-color: #fff; border: 1px solid var(--se-edge); border-radius: 0.75rem; }
    main > div > div:has(> #account_settings_menu) + div .collapse-title { font-size: 1rem; font-weight: 600; text-transform: none; }
    @media (min-width: 768px) {
      main > div:has(> div > #account_settings_menu) { display: flex; flex-wrap: nowrap; align-items: flex-start; column-gap: 3rem; }
      main > div:has(> div > #account_settings_menu) > * { margin: 0; }
      main > div > div:has(> #account_settings_menu) + div { flex: 1 1 0%; }
      main > div > div:has(> #account_settings_menu) + div .table :is(th, td) { padding-inline: 0.875rem; }
    }
    @media (max-width: 767px) {
      main > div > div:has(> #account_settings_menu) + div .table-stack tr { background: #fff; border: 1px solid var(--se-edge); border-radius: 0.75rem; }
    }
    /* Settings: lists of records and certificates (white panel, rows divided by a hairline) */
    .se-rows { list-style: none; margin: 0; padding: 0; background: #fff; border: 1px solid #ddd5c6; border-radius: 0.75rem; }
    .se-row { padding: 1.25rem 1.5rem; }
    .se-row + .se-row { border-top: 1px solid #e6dfd2; }
    .se-row__title { margin: 0; font-size: 1.0625rem; font-weight: 600; line-height: 1.4; color: #1f2948; text-wrap: pretty; overflow-wrap: anywhere; }
    .se-row__meta { margin: 0.2rem 0 0; font-size: 0.875rem; color: #4f5d70; font-variant-numeric: tabular-nums; }
    .se-row__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-top: 1rem; }
    .se-row__actions svg { width: 1.125rem; height: 1.125rem; flex: none; }
    .se-pairs { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 0.3rem 1.25rem; margin: 0.875rem 0 0; font-size: 0.9375rem; line-height: 1.5; }
    .se-pairs dt { color: #4f5d70; }
    .se-pairs dd { margin: 0; color: #1f2948; overflow-wrap: anywhere; }
    .se-pairs dd .se-quiet { color: #4f5d70; }
    .se-pairs code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.8125rem; line-height: 1.6; color: #1f2948; overflow-wrap: normal; word-break: normal; }
    .se-note { display: flex; align-items: flex-start; gap: 0.5rem; margin: 0.875rem 0 0; font-size: 0.875rem; line-height: 1.5; color: #3a4461; }
    .se-note svg { width: 1.125rem; height: 1.125rem; flex: none; margin-top: 0.05rem; color: #2e6b47; }
    .se-note--warn, .se-note--warn svg { color: #9a2d33; }
    .se-note--key svg { color: #2f3e68; }
    .se-status { display: inline-flex; align-items: center; height: 1.625rem; padding-inline: 0.65rem; border-radius: 999px; font-size: 0.8125rem; font-weight: 600; line-height: 1; white-space: nowrap; }
    .se-status--active { background: #e3efe7; color: #1f5135; }
    .se-status--retired { background: #efebe3; color: #4f5d70; }
    .se-section-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem 1rem; margin: 2.75rem 0 0.75rem; }
    .se-section-head h2 { margin: 0; }
    .se-section-head .se-status { margin-right: auto; }
    .se-section-head--first { margin-top: 0; }
    .se-note--lead { margin: 0 0 1rem; }
    .se-section-lede { margin: 0 0 1rem; max-width: 75ch; color: #3a4461; }
    .se-dropzone { background: #fff; border: 1px dashed #7b8597; border-radius: 0.75rem; transition: background-color .2s; }
    .se-dropzone:hover { background: #fbfaf7; }
    @media (max-width: 639px) { .se-row { padding: 1rem 1.125rem; } .se-pairs { grid-template-columns: minmax(0, 1fr); gap: 0 0; } .se-pairs dd + dt { margin-top: 0.5rem; } }
    .se-site-footer .se-footer-grid > div:first-child p { font-size: 0.9375rem; }
    .se ::selection { background: #2f3e6826; color: var(--ink); }
    .se a { color: inherit; text-underline-offset: 0.22em; text-decoration-thickness: 1px; }
    .se a:focus-visible, .se .se-btn:focus-visible { outline: 3px solid var(--crimson); outline-offset: 3px; border-radius: 6px; }
    .se-wrap { width: 100%; max-width: 76rem; margin-inline: auto; padding-inline: 1.5rem; }
    .se-serif { font-family: 'Cormorant Garamond', ui-serif, Georgia, serif; color: var(--ink); font-weight: 600; letter-spacing: -0.012em; text-wrap: balance; }
    .se-skip { position: absolute; left: -9999px; top: 0.5rem; z-index: 60; background: var(--navy); color: #fff !important; padding: 0.6rem 1rem; border-radius: 6px; }
    .se-skip:focus { left: 1rem; }
    .se-site-header { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid #e0dcd0; }
    .se-site-header::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: color-mix(in srgb, var(--cream) 88%, transparent); backdrop-filter: saturate(180%) blur(14px); -webkit-backdrop-filter: saturate(180%) blur(14px); }
    .se-site-header__inner { display: flex; align-items: center; gap: 1.5rem; height: 72px; }
    .se-brand { display: inline-flex; align-items: center; gap: 0.75rem; text-decoration: none !important; color: var(--ink); flex-shrink: 0; }
    .se-brand:hover { opacity: .85; }
    .se-brand__logo { height: 48px; width: auto; display: block; }
    .se-brand__name { display: block; font-family: 'Cormorant Garamond', ui-serif, Georgia, serif; font-size: 1.6rem; font-weight: 600; letter-spacing: -0.01em; line-height: 1; }
    .se-brand__tag { display: block; margin-top: 2px; color: var(--muted); font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; }
    .se-nav { display: none; align-items: center; gap: 0.25rem; margin-left: auto; }
    .se-nav a { display: inline-block; padding: 0.5rem 0.75rem; font-size: 0.9375rem; font-weight: 500; color: var(--ink); text-decoration: none; border-radius: 4px; transition: background .2s, color .2s; }
    .se-nav a:hover { background: #efebe3; color: var(--crimson); }
    .se-header-action { margin-left: auto; }
    .se-hero { display: grid; grid-template-columns: 1fr; gap: 2.5rem; padding-block: 2.5rem 4.5rem; align-items: center; }
    .se-hero h1 { text-wrap: balance; }
    .se-hero h1 { font-size: clamp(2.4rem, 4.4vw, 3.6rem); line-height: 1.05; margin: 0; }
    .se-lede { margin: 1.5rem 0 0; max-width: 34rem; font-size: 1.1875rem; color: var(--text); }
    .se-actions { margin-top: 2.25rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; }
    .se-btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem; height: 3.25rem; padding-inline: 1.9rem; border-radius: 999px; background: var(--navy); color: #f7f5f1 !important; font-weight: 600; text-decoration: none; white-space: nowrap;
      box-shadow: 0 10px 24px -14px #1f294899; transition: background-color .25s cubic-bezier(.16,1,.3,1), transform .2s cubic-bezier(.16,1,.3,1), box-shadow .25s; }
    .se-btn:hover { background: var(--navy-deep); box-shadow: 0 14px 28px -14px #1f2948b3; }
    .se-btn:active { transform: translateY(1px); }
    .se-btn svg { width: 1.2rem; height: 1.2rem; }
    .se-btn.se-btn--accent { background: var(--crimson); color: #fff !important; }
    .se-btn.se-btn--accent:hover { background: #9a2d33; }
    .se-btn.se-btn--sm { height: 2.75rem; padding-inline: 1.4rem; font-size: 0.9375rem; border-radius: 4px; box-shadow: none; }
    .se-link { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600; color: var(--navy) !important; text-decoration: underline; text-decoration-color: #2f3e6855; }
    .se-link:hover { text-decoration-color: var(--crimson); }
    .se-link svg { width: 1.05rem; height: 1.05rem; }
    .se-section { padding-block: 4.5rem; }
    .se-h2 { font-size: clamp(2rem, 3.6vw, 2.75rem); line-height: 1.1; margin: 0; }
    .se-panel { position: relative; overflow: hidden; isolation: isolate; background: #2c324a; color: rgba(247,245,241,.86); border-radius: 16px; padding: 2rem 1.75rem 0; box-shadow: 0 30px 60px -36px #1f294899; }
    .se-panel::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 3px; background: var(--crimson); }
    .se-panel h2 { color: var(--cream); font-size: 1.85rem; line-height: 1.1; margin: 0 0 1.5rem; }
    .se-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.4rem; position: relative; z-index: 1; }
    .se-steps li { display: grid; grid-template-columns: 2.5rem 1fr; gap: 0.9rem; align-items: start; }
