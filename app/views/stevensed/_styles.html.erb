      .se-rise-2 { animation-delay: .08s; } .se-rise-3 { animation-delay: .16s; }
      @keyframes se-rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
      @keyframes se-reveal { from { clip-path: inset(100% 0 0 0); opacity: .4; } to { clip-path: inset(0 0 0 0); opacity: 1; } }
    }
    /* StevensED signer fixes (stevensed/signer-fixes): consent step eyebrow in sentence case. */
    .se-gate__eyebrow.se-gate__eyebrow--from { text-transform: none; letter-spacing: 0.01em; font-size: 0.875rem; }
