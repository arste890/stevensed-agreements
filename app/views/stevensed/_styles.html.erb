<%# StevensED public pages: brand type and tokens (stevensed.org, policies.stevensed.org). Fonts: OFL, self-hosted. %>
<% content_for :head do %>
  <link rel="preload" href="/stevensed/fonts/cormorant-garamond-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/stevensed/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <style>
    @font-face { font-family: 'Cormorant Garamond'; src: url('/stevensed/fonts/cormorant-garamond-latin-wght-normal.woff2') format('woff2'); font-weight: 300 700; font-display: swap; }
    @font-face { font-family: 'Inter'; src: url('/stevensed/fonts/inter-latin-wght-normal.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
    .se { --navy: #2f3e68; --navy-deep: #26335a; --ink: #1f2948; --text: #3a4461; --muted: #59697a; --crimson: #c13f44; --cream: #f7f5f1; --parchment: #e9e3d8; --rule: #d8d0c1;
      background: var(--cream); color: var(--text); font-family: 'Inter', ui-sans-serif, system-ui, sans-serif; font-size: 1.0625rem; line-height: 1.65; min-height: 100dvh; display: flex; flex-direction: column;
      -webkit-font-smoothing: antialiased; font-feature-settings: 'cv11', 'ss01'; caret-color: var(--crimson); }
    .se ::selection { background: #2f3e6826; color: var(--ink); }
    .se a { color: inherit; text-underline-offset: 0.22em; text-decoration-thickness: 1px; }
    .se a:focus-visible, .se .se-btn:focus-visible { outline: 3px solid var(--crimson); outline-offset: 3px; border-radius: 6px; }
    .se-wrap { width: 100%; max-width: 76rem; margin-inline: auto; padding-inline: 1.5rem; }
    .se-serif { font-family: 'Cormorant Garamond', ui-serif, Georgia, serif; color: var(--ink); font-weight: 600; letter-spacing: -0.012em; text-wrap: balance; }
    .se-skip { position: absolute; left: -9999px; top: 0.5rem; z-index: 60; background: var(--navy); color: #fff !important; padding: 0.6rem 1rem; border-radius: 6px; }
    .se-skip:focus { left: 1rem; }
    .se-site-header { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid #e0dcd0; }
    .se-site-header::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: color-mix(in srgb, var(--cream) 88%, transparent); backdrop-filter: saturate(180%) blur(14px); -webkit-backdrop-filter: saturate(180%) blur(14px); }
    .se-site-header__inner { display: flex; align-items: center; gap: 1.5rem; height: 72px; }
    .se-brand { display: inline-flex; align-items: center; gap: 0.75rem; text-decoration: none !important; color: var(--ink); flex-shrink: 0; }
    .se-brand:hover { opacity: .85; }
    .se-brand__logo { height: 48px; width: auto; display: block; }
    .se-brand__name { display: block; font-family: 'Cormorant Garamond', ui-serif, Georgia, serif; font-size: 1.6rem; font-weight: 600; letter-spacing: -0.01em; line-height: 1; }
    .se-brand__tag { display: block; margin-top: 2px; color: var(--muted); font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; }
    .se-nav { display: none; align-items: center; gap: 0.25rem; margin-left: auto; }
    .se-nav a { display: inline-block; padding: 0.5rem 0.75rem; font-size: 0.9375rem; font-weight: 500; color: var(--ink); text-decoration: none; border-radius: 4px; transition: background .2s, color .2s; }
    .se-nav a:hover { background: #efebe3; color: var(--crimson); }
    .se-header-action { margin-left: auto; }
    .se-btn--accent { background: var(--crimson); }
    .se-btn--accent:hover { background: #9a2d33; }
    .se-btn--sm { height: 2.75rem; padding-inline: 1.4rem; font-size: 0.9375rem; border-radius: 4px; box-shadow: none; }
    .se-hero { display: grid; grid-template-columns: 1fr; gap: 2.5rem; padding-block: 2.5rem 4.5rem; align-items: center; }
    .se-hero h1 { text-wrap: balance; }
    .se-hero h1 { font-size: clamp(2.5rem, 5vw, 3.9rem); line-height: 1.05; margin: 0; }
    .se-lede { margin: 1.5rem 0 0; max-width: 34rem; font-size: 1.1875rem; color: var(--text); }
    .se-actions { margin-top: 2.25rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; }
    .se-btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem; height: 3.25rem; padding-inline: 1.9rem; border-radius: 999px; background: var(--navy); color: #f7f5f1 !important; font-weight: 600; text-decoration: none; white-space: nowrap;
      box-shadow: 0 10px 24px -14px #1f294899; transition: background-color .25s cubic-bezier(.16,1,.3,1), transform .2s cubic-bezier(.16,1,.3,1), box-shadow .25s; }
    .se-btn:hover { background: var(--navy-deep); box-shadow: 0 14px 28px -14px #1f2948b3; }
    .se-btn:active { transform: translateY(1px); }
    .se-btn svg { width: 1.2rem; height: 1.2rem; }
    .se-link { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600; color: var(--navy) !important; text-decoration: underline; text-decoration-color: #2f3e6855; }
    .se-link:hover { text-decoration-color: var(--crimson); }
    .se-link svg { width: 1.05rem; height: 1.05rem; }
    .se-section { padding-block: 4.5rem; }
    .se-h2 { font-size: clamp(2rem, 3.6vw, 2.75rem); line-height: 1.1; margin: 0; }
    .se-panel { position: relative; overflow: hidden; isolation: isolate; background: #2c324a; color: rgba(247,245,241,.86); border-radius: 16px; padding: 2rem 1.75rem 0; box-shadow: 0 30px 60px -36px #1f294899; }
    .se-panel::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 3px; background: var(--crimson); }
    .se-panel h2 { color: var(--cream); font-size: 1.85rem; line-height: 1.1; margin: 0 0 1.5rem; }
    .se-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.4rem; position: relative; z-index: 1; }
    .se-steps li { display: grid; grid-template-columns: 2.5rem 1fr; gap: 0.9rem; align-items: start; }
    .se-steps .se-icon { width: 2.5rem; height: 2.5rem; border-radius: 999px; background: rgba(247,245,241,.1); color: #f0a7a9; display: grid; place-items: center; }
    .se-steps .se-icon svg { width: 1.2rem; height: 1.2rem; }
    .se-steps h3 { margin: 0.15rem 0 0.25rem; font-size: 1rem; font-weight: 600; color: var(--cream); }
    .se-steps p { margin: 0; font-size: 0.9375rem; line-height: 1.6; color: rgba(247,245,241,.78); }
    .se-panel__skyline { display: block; width: calc(100% + 3.5rem); max-width: none; margin: 1.25rem -1.75rem 0; height: auto; aspect-ratio: 3500 / 1180; }
    .se-band { background: var(--parchment); }
    .se-consent { display: grid; grid-template-columns: 1fr; gap: 2.5rem 4rem; }
    .se-consent p { margin: 1.25rem 0 0; max-width: 38rem; }
    .se-docs { display: grid; grid-template-columns: 1fr; gap: 0.75rem; align-content: start; }
    .se-doc { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.05rem 1.25rem; border-radius: 12px; background: #f7f5f1cc; text-decoration: none !important;
      transition: background-color .25s cubic-bezier(.16,1,.3,1), transform .25s cubic-bezier(.16,1,.3,1); }
    .se-doc:hover { background: var(--cream); transform: translateX(2px); }
    .se-doc strong { display: block; color: var(--ink); font-weight: 600; font-size: 1rem; line-height: 1.35; }
    .se-doc span { display: block; color: var(--muted); font-size: 0.875rem; font-variant-numeric: tabular-nums; }
    .se-doc svg { width: 1.15rem; height: 1.15rem; color: var(--navy); flex: none; }
    .se-site-footer { margin-top: auto; background: var(--navy); color: rgba(247,245,241,.82); padding: 4rem 0 2rem; font-size: 0.9375rem; }
    .se-site-footer a { color: rgba(247,245,241,.82); text-decoration-color: transparent; }
    .se-site-footer a:hover { color: #f0a7a9; text-decoration-color: #f0a7a9; }
    .se-site-footer a:focus-visible { outline-color: #f0a7a9; }
    .se-brand--light .se-brand__name { color: var(--cream); }
    .se-brand--light .se-brand__tag { color: rgba(247,245,241,.78); }
    .se-footer-grid { display: grid; grid-template-columns: 1fr; gap: 2.25rem; margin-bottom: 2.75rem; }
    .se-footer-about { margin-top: 1rem; max-width: 34ch; color: rgba(255,255,255,.72); }
    .se-footer-heading { font-size: 0.875rem; letter-spacing: 0.16em; text-transform: uppercase; margin: 0 0 1rem; color: #f0a7a9; font-weight: 600; }
    .se-footer-grid ul { list-style: none; padding: 0; margin: 0; }
    .se-footer-grid li + li { margin-top: 0.5rem; }
    .se-footer-area { margin: 0 0 0.75rem; color: rgba(255,255,255,.75); }
    .se-site-footer address { font-style: normal; color: rgba(255,255,255,.75); line-height: 1.8; }
    .se-footer-bottom { border-top: 1px solid rgba(255,255,255,.1); padding-top: 1.5rem; display: grid; grid-template-columns: 1fr; gap: 0.75rem 2rem; align-items: baseline; font-size: 0.8125rem; letter-spacing: 0.06em; color: rgba(255,255,255,.78); }
    .se-footer-bottom p { margin: 0; }
    .se-legal-links { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; list-style: none; padding: 0; margin: 0; }
    .se-prose { max-width: 44rem; padding-block: 2.5rem 4.5rem; }
    .se-prose h1 { font-size: clamp(2.4rem, 5vw, 3.4rem); line-height: 1.06; margin: 0 0 1.5rem; }
    .se-prose h2 { font-family: 'Cormorant Garamond', ui-serif, Georgia, serif; font-weight: 600; color: var(--ink); font-size: 1.75rem; line-height: 1.2; margin: 2.5rem 0 0.75rem; }
    .se-prose p, .se-prose li { max-width: 68ch; }
    .se-prose ul { padding-left: 1.2rem; }
    .se-signin { max-width: 28rem; margin-inline: auto; padding-block: 3rem 5rem; }
    .se-signin h1 { font-size: clamp(2.4rem, 5vw, 3.2rem); line-height: 1.05; margin: 0; }
    .se-signin-lede { margin: 0.9rem 0 2rem; color: var(--text); }
    .se-signin-actions { display: grid; gap: 0.75rem; }
    .se-btn-block { width: 100%; }
    .se-contents { display: contents; }
    .se-btn-quiet { background: transparent; color: var(--navy) !important; box-shadow: inset 0 0 0 1.5px var(--navy); }
    .se-btn-quiet:hover { background: #2f3e6810; box-shadow: inset 0 0 0 1.5px var(--navy-deep); }
    .se-local { margin-top: 1.75rem; }
    .se-local summary { cursor: pointer; color: var(--navy); font-weight: 600; text-decoration: underline; text-decoration-color: #2f3e6855; text-underline-offset: 0.22em; list-style: none; width: fit-content; }
    .se-local summary::-webkit-details-marker { display: none; }
    .se-local summary:hover { text-decoration-color: var(--crimson); }
    .se-local summary:focus-visible { outline: 3px solid var(--crimson); outline-offset: 3px; border-radius: 6px; }
    .se-local[open] summary { margin-bottom: 1.25rem; }
    .se-local-form .label { color: var(--ink); }
    .se-local-form a { color: var(--navy); }
    .se-signin-note { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--rule); color: var(--muted); font-size: 0.9375rem; }
    @media (min-width: 768px) {
      .se-footer-grid { grid-template-columns: 1.4fr 1fr 1.2fr 1fr; gap: 3rem; }
      .se-footer-bottom { grid-template-columns: 1fr auto; }
      .se-legal-links { justify-content: flex-end; }
      .se-wrap { padding-inline: 2.5rem; }
      .se-hero { grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 3rem; padding-block: 3.5rem 6rem; }
      .se-hero > div:first-child { grid-column: 1 / span 6; }
      .se-panel { grid-column: 8 / span 5; padding: 2.25rem 2.25rem 0; }
      .se-panel__skyline { width: calc(100% + 4.5rem); margin: 1.5rem -2.25rem 0; }
      .se-consent { grid-template-columns: repeat(12, minmax(0, 1fr)); }
      .se-consent > :first-child { grid-column: 1 / span 6; }
      .se-docs { grid-column: 8 / span 5; }
      .se-section { padding-block: 6rem; }
    }
    @media (min-width: 1024px) { .se-nav { display: flex; } .se-header-action { margin-left: 0.5rem; } }
    @media (prefers-reduced-motion: no-preference) {
      .se-rise { animation: se-rise .8s cubic-bezier(.16,1,.3,1) both; }
      .se-rise-2 { animation-delay: .08s; } .se-rise-3 { animation-delay: .16s; }
      @keyframes se-rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
      @keyframes se-reveal { from { clip-path: inset(100% 0 0 0); opacity: .4; } to { clip-path: inset(0 0 0 0); opacity: 1; } }
    }
  </style>
<% end %>
