<%# StevensED: footer matching stevensed.org (navy, brand, columns, legal links); content specific to Agreements. %>
<% policies = 'https://policies.stevensed.org/#/doc' %>
<footer class="se-site-footer">
  <div class="se-wrap">
    <div class="se-footer-grid">
      <div>
        <a class="se-brand se-brand--light" href="<%= root_path %>" aria-label="StevensED Agreements home">
          <img class="se-brand__logo" src="/stevensed/book-mark-white.svg" alt="" width="65" height="48">
          <span><span class="se-brand__name">StevensED</span><span class="se-brand__tag">Agreements</span></span>
        </a>
        <p class="se-footer-about">StevensED's electronic signing service for enrollment, consent and other agreements, operated by the Office of Legal Operations and Institutional Compliance.</p>
      </div>
      <div>
        <h2 class="se-footer-heading">Agreements</h2>
        <ul>
          <li><a href="<%= root_path %>#how">How signing works</a></li>
          <li><a href="<%= Stevensed::Sso.oidc_enabled? ? new_user_session_path : new_user_session_path(local: 1) %>"><%= t('sign_in') %></a></li>
          <li><a href="<%= stevensed_accessibility_path %>">Accessibility</a></li>
          <li><a href="<%= legal_notices_path %>">Legal notices</a></li>
        </ul>
      </div>
      <div>
        <h2 class="se-footer-heading">Policies</h2>
        <ul>
          <li><a href="<%= policies %>/e-signature-consent">Electronic Records and Signature Consent</a></li>
          <li><a href="<%= policies %>/student-records-privacy">Student Records and Privacy</a></li>
          <li><a href="<%= policies %>/data-protection">Data Protection and Security</a></li>
          <li><a href="<%= policies %>/records-retention">Records Retention</a></li>
          <li><a href="https://policies.stevensed.org" rel="noopener">Policy Library</a></li>
        </ul>
      </div>
      <div>
        <h2 class="se-footer-heading">Contact</h2>
        <p class="se-footer-area">Office of Legal Operations and Institutional Compliance</p>
        <address>P.O. Box 900342<br>Sandy, UT 84090<br><a href="tel:+18014133879">(801) 413-3879</a><br><a href="mailto:<%= Stevensed::CONTACT_EMAIL %>"><%= Stevensed::CONTACT_EMAIL %></a></address>
      </div>
    </div>
    <div class="se-footer-bottom">
      <p>Copyright &copy; <%= Time.current.year %> StevensED. All rights reserved.</p>
      <ul class="se-legal-links">
        <li><a href="https://stevensed.org/privacy/">Privacy</a></li>
        <li><a href="https://stevensed.org/cookies/">Cookies</a></li>
        <li><a href="https://stevensed.org/terms/">Terms</a></li>
        <li><a href="https://stevensed.org/disclaimer/">Disclaimer</a></li>
        <li><a href="https://stevensed.org/acceptable-use/">Acceptable Use</a></li>
        <li><a href="<%= stevensed_accessibility_path %>">Accessibility</a></li>
      </ul>
    </div>
  </div>
</footer>
