<%# StevensED: roles. Admin manages everything; Editor sends and manages templates and submissions;
    Viewer reads templates and submissions; Client sees only their own agreements. %>
<div class="form-control">
  <%= f.label :role, class: 'label' %>
  <%= f.select :role, User::ROLES.map { |role| [t(role, default: role.humanize), role] }, {}, class: 'base-select' %>
  <label class="label"><span class="label-text-alt"><%= t('stevensed.roles_hint') %></span></label>
</div>
