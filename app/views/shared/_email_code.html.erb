<%# StevensED: one-time code panel. Specs read the code from the first <b> element, so keep it a bare <b>. Locals: code. %>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:4px 0 24px 0;">
  <tr>
    <td class="se-code" align="center" style="background-color:#F7F5F1;border:1px solid #D8D0C1;border-radius:2px;padding:14px 28px;font-family:'SFMono-Regular', Menlo, Consolas, 'Courier New', monospace;font-size:28px;line-height:34px;letter-spacing:6px;color:#1F2948;"><b><%= code %></b></td>
  </tr>
</table>
