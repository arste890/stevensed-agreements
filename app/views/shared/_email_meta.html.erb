<%# StevensED: letterhead meta lines (Date, Reference, Respond by). Locals: submission (optional), respond_by (default false), account (optional, for the time zone). %>
<% submission = local_assigns[:submission] %>
<% zone = local_assigns[:account]&.timezone.presence || Time.zone.name %>
<% rows = [[t('stevensed.email.date'), l(Time.current.in_time_zone(zone).to_date, format: :long)]] %>
<% rows << [t('stevensed.email.reference'), format('SA-%<year>d-%<id>05d', year: submission.created_at.year, id: submission.id)] if submission %>
<% rows << [t('stevensed.email.respond_by'), l(submission.expire_at.in_time_zone(zone).to_date, format: :long)] if submission&.expire_at && local_assigns[:respond_by] %>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" class="se-sans">
  <% rows.each do |(label, value)| %>
    <tr>
      <td class="se-muted" width="120" style="width:120px;padding:0 0 4px 0;font-family:Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:10px;line-height:18px;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:#59697A;vertical-align:top;"><%= label %></td>
      <td class="se-strong" style="padding:0 0 4px 0;font-family:<%= label == t('stevensed.email.reference') ? "'SFMono-Regular', Menlo, Consolas, 'Courier New', monospace" : "Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif" %>;font-size:13px;line-height:18px;color:#1F2948;vertical-align:top;"><%= value %></td>
    </tr>
  <% end %>
</table>
