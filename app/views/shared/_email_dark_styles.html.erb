<%# StevensED: the dark palette from Stevensed::EmailDarkStyles, for prefers-color-scheme and for Outlook's [data-ogsc] / [data-ogsb] attributes. %>
      @media (prefers-color-scheme: dark) {
<% Stevensed::EmailDarkStyles::RULES.each do |selector, declarations| %>
        <%= selector %> { <%= declarations %> }
<% end %>
      }
<% Stevensed::EmailDarkStyles::RULES.each do |selector, declarations| %>
      <%= Stevensed::EmailDarkStyles.outlook_selector(selector) %> { <%= declarations %> }
<% end %>
