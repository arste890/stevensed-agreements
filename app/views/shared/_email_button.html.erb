<%# StevensED: bulletproof primary button (border-based, clickable in Outlook). Locals: url, label, fallback (default true). %>
<table role="presentation" class="se-button" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 24px 0;">
  <tr>
    <td align="center" bgcolor="#2F3E68" style="background-color:#2F3E68;border-radius:4px;">
      <a href="<%= url %>" target="_blank" style="display:inline-block;background-color:#2F3E68;border-top:14px solid #2F3E68;border-bottom:14px solid #2F3E68;border-left:32px solid #2F3E68;border-right:32px solid #2F3E68;border-radius:4px;font-family:Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;line-height:20px;font-weight:600;color:#FFFFFF;text-decoration:none;letter-spacing:0.2px;"><%= label %></a>
    </td>
  </tr>
</table>
<% if local_assigns.fetch(:fallback, true) %>
  <!-- start text/html -->
  <p class="se-muted" style="margin:0 0 20px 0;font-size:12px;line-height:18px;color:#59697A;word-break:break-all;"><%= t('stevensed.email.button_fallback') %><br><a href="<%= url %>" class="se-link" style="color:#2F3E68;text-decoration:underline;"><%= url %></a></p>
  <!-- end text/html -->
<% end %>
