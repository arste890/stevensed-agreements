<%# StevensED: bulletproof primary button (border-based, clickable in Outlook). Locals: url, label, fallback (default true). %>
<table role="presentation" class="se-button" cellpadding="0" cellspacing="0" border="0" style="margin:4px 0 22px 0;">
  <tr>
    <td align="center" bgcolor="#1F2948" style="background-color:#1F2948;border-radius:2px;">
      <a href="<%= url %>" target="_blank" style="display:inline-block;background-color:#1F2948;border-top:13px solid #1F2948;border-bottom:13px solid #1F2948;border-left:30px solid #1F2948;border-right:30px solid #1F2948;border-radius:2px;font-family:Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;line-height:20px;font-weight:600;color:#FFFFFF;text-decoration:none;letter-spacing:0.2px;"><%= label %></a>
    </td>
  </tr>
</table>
<% if local_assigns.fetch(:fallback, true) %>
  <!-- start text/html -->
  <p class="se-muted" style="margin:0 0 20px 0;font-family:Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:12px;line-height:18px;color:#59697A;"><%= t('stevensed.email.button_fallback') %><br><a href="<%= url %>" class="se-link" style="color:#2F3E68;text-decoration:underline;word-break:break-all;"><%= url %></a></p>
  <!-- end text/html -->
<% end %>
