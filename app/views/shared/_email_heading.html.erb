<%# StevensED: letter subject line ("Re: ..."). Locals: title, eyebrow (optional status tag). %>
<% if local_assigns[:eyebrow].present? %>
  <p style="margin:0 0 8px 0;"><span style="display:inline-block;font-family:Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:10px;line-height:14px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#A7353A;background-color:#FBEDED;border:1px solid #F0CACB;padding:3px 8px;border-radius:2px;"><%= local_assigns[:eyebrow] %></span></p>
<% end %>
<p class="se-title" style="margin:0 0 18px 0;font-family:Georgia, 'Times New Roman', serif;font-size:17px;line-height:26px;font-weight:bold;color:#1F2948;"><%= title %></p>
