<%# StevensED: formal sign-off used by every email. %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
  <tr>
    <td class="se-text se-sans se-rule" style="border-top:1px solid #E9E3D8;padding-top:20px;font-family:Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:14px;line-height:22px;color:#1F2948;">
      <p style="margin:0;"><%= t('stevensed.email.sincerely') %>,</p>
      <p style="margin:8px 0 0 0;"><span class="se-strong" style="font-family:'Cormorant Garamond', Georgia, 'Times New Roman', serif;font-size:18px;line-height:24px;font-weight:600;color:#2F3E68;"><%= Stevensed::OFFICE %></span><br><span class="se-muted" style="color:#59697A;"><%= Stevensed::ORGANIZATION %> | <a href="mailto:<%= Stevensed::CONTACT_EMAIL %>" class="se-link" style="color:#2F3E68;text-decoration:underline;"><%= Stevensed::CONTACT_EMAIL %></a></span></p>
    </td>
  </tr>
</table>
