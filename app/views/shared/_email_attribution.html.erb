<%# StevensED: institutional letterhead footer (ASCII only). %>
<% link_style = 'color:#2F3E68;text-decoration:underline;white-space:nowrap;' %>
<% legal_links = [] %>
<% legal_links << [t('stevensed.email.footer_privacy'), 'https://stevensed.org/privacy/'] %>
<% legal_links << [t('stevensed.email.footer_terms'), 'https://stevensed.org/terms/'] %>
<% legal_links << [t('stevensed.email.footer_esign_consent'), 'https://policies.stevensed.org/#/doc/e-signature-consent'] %>
<% legal_links << [t('stevensed.legal_notices'), 'https://agreements.stevensed.org/legal'] %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
  <tr>
    <td class="se-muted se-sans se-rule" style="border-top:1px solid #D8D0C1;padding-top:14px;font-family:Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:11px;line-height:17px;color:#59697A;">
      <p style="margin:0 0 10px 0;"><strong class="se-strong" style="color:#1F2948;"><%= t('stevensed.email.confidentiality_title') %></strong> <%= t('stevensed.email.confidentiality_body', email: Stevensed::CONTACT_EMAIL) %></p>
      <p style="margin:0 0 8px 0;"><strong class="se-strong" style="color:#1F2948;">StevensED LLC</strong> | <%= Stevensed::OFFICE %><br>P.O. Box 900342, Sandy, UT 84090 | <a href="mailto:<%= Stevensed::CONTACT_EMAIL %>" class="se-link" style="<%= link_style %>"><%= Stevensed::CONTACT_EMAIL %></a></p>
      <p style="margin:0 0 8px 0;"><%= safe_join(legal_links.map { |(label, url)| link_to(label, url, class: 'se-link', style: link_style) }, ' | ') %></p>
      <p style="margin:0;"><%= t('stevensed.email.footer_notice', product_name: Stevensed::PRODUCT_NAME) %></p>
    </td>
  </tr>
</table>
