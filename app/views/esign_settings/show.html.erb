<% content_for(:native_title, t('e_signature')) if turbo_native_app? %>
<div class="flex flex-wrap space-y-4 md:flex-nowrap md:space-y-0">
  <%= render 'shared/settings_nav' %>
  <div class="flex-grow">
    <h1 class="text-3xl md:text-4xl font-bold mb-4"><%= t('stevensed.esign.title') %></h1>
    <p><%= t('stevensed.esign.intro') %></p>
    <% if @vault_chain.present? %>
      <section aria-labelledby="signing_certificate_in_use">
        <div class="se-section-head se-section-head--first">
          <h2 id="signing_certificate_in_use" class="text-2xl font-bold"><%= t('stevensed.esign.vault_heading') %></h2>
          <span class="se-status se-status--active"><%= t('stevensed.esign.in_use') %></span>
        </div>
        <p class="se-note se-note--key se-note--lead"><%= svg_icon('lock', class: 'w-5 h-5') %><span><%= t('stevensed.esign.vault_key_statement') %></span></p>
        <ol class="se-rows" role="list">
          <% @vault_chain.each do |role, cert| %>
            <li class="se-row">
              <h3 class="se-row__title"><%= cert.common_name %></h3>
              <p class="se-row__meta"><%= t("stevensed.esign.role_#{role}") %></p>
              <dl class="se-pairs">
                <dt><%= t('stevensed.esign.subject') %></dt>
                <dd><%= cert.subject %></dd>
                <dt><%= t('stevensed.esign.issuer') %></dt>
                <dd><%= cert.issuer %></dd>
                <dt><%= t('stevensed.esign.validity') %></dt>
                <dd><%= t('stevensed.esign.validity_range', from: l(cert.not_before.to_date, format: :long), to: l(cert.not_after.to_date, format: :long)) %></dd>
                <dt><%= t('stevensed.esign.key_algorithm') %></dt>
                <dd><%= cert.key_algorithm %></dd>
                <dt><%= t('stevensed.esign.fingerprint') %></dt>
                <dd><code><%= safe_join(cert.fingerprint.split(':'), safe_join([':', tag.wbr])) %></code></dd>
              </dl>
            </li>
          <% end %>
        </ol>
      </section>
    <% end %>
    <section aria-labelledby="signing_certificates">
      <div class="se-section-head <%= 'se-section-head--first' if @vault_chain.blank? %>">
        <h2 id="signing_certificates" class="text-2xl font-bold">
          <%= @vault_chain.present? ? t('stevensed.esign.other_certificates') : t('stevensed.esign.signing_certificates') %>
        </h2>
        <% if can?(:create, @encrypted_config) %>
          <%= link_to new_settings_esign_path, class: 'white-button', aria: { label: t('upload_certificate') }, data: { turbo_frame: 'modal' } do %>
            <%= svg_icon('plus', class: 'w-5 h-5') %>
            <span><%= t('stevensed.esign.upload_cert') %></span>
          <% end %>
        <% end %>
      </div>
      <% if @vault_chain.present? %>
        <p class="se-section-lede"><%= t('stevensed.esign.other_certificates_lede') %></p>
      <% end %>
      <%= render 'alert' %>
      <% items = @pkcs_list.select { |item| item['pkcs'].present? } %>
      <% if items.any? %>
        <ul class="se-rows" role="list">
          <% items.each do |item| %>
            <% autogenerated = item['name'] == EsignSettingsController::DEFAULT_CERT_NAME %>
            <li class="se-row">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <h3 class="se-row__title"><%= autogenerated ? t('stevensed.esign.autogenerated_name') : item['name'] %></h3>
                <% if @vault_chain.blank? && item['status'] == 'default' %>
                  <span class="se-status se-status--active"><%= t('stevensed.esign.default') %></span>
                <% elsif @vault_chain.present? && autogenerated %>
                  <span class="se-status se-status--retired"><%= t('stevensed.esign.retired') %></span>
                <% end %>
              </div>
              <p class="se-row__meta"><%= t('stevensed.esign.valid_to', date: l(item['pkcs'].certificate.not_after.to_date, format: :long)) %></p>
              <% if @vault_chain.present? %>
                <p class="se-note se-note--key">
                  <%= svg_icon('clock', class: 'w-5 h-5') %>
                  <span>
                    <% if autogenerated %>
                      <%= t('stevensed.esign.retired_note', date: l(EsignSettingsController::VAULT_SIGNING_SINCE.to_date, format: :long)) %>
                    <% else %>
                      <%= t('stevensed.esign.not_in_use_note') %>
                    <% end %>
                  </span>
                </p>
              <% end %>
              <% can_make_default = @vault_chain.blank? && item['status'] != 'default' && can?(:update, @encrypted_config) %>
              <% can_remove = !autogenerated && item['status'] != 'default' && can?(:destroy, @encrypted_config) %>
              <% if can_make_default || can_remove %>
                <div class="se-row__actions">
                  <% if can_make_default %>
                    <%= button_to t('stevensed.esign.make_default'), settings_esign_path, method: :put, params: { name: item['name'] }, class: 'white-button', data: { turbo_confirm: t('are_you_sure_') } %>
                  <% end %>
                  <% if can_remove %>
                    <%= button_to t('remove'), settings_esign_path, method: :delete, params: { name: item['name'] }, class: 'white-button', data: { turbo_confirm: t('are_you_sure_') } %>
                  <% end %>
                </div>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
    <% encrypted_config = EncryptedConfig.find_or_initialize_by(account: current_account, key: EncryptedConfig::TIMESTAMP_SERVER_URL_KEY) %>
    <% if !Docuseal.multitenant? && can?(:manage, encrypted_config) %>
      <section aria-labelledby="timestamp_authority">
        <div class="se-section-head">
          <h2 id="timestamp_authority" class="text-2xl font-bold"><%= t('stevensed.esign.timestamp_heading') %></h2>
          <% if encrypted_config.value.present? %>
            <span class="se-status se-status--active"><%= t('stevensed.esign.in_use') %></span>
          <% end %>
        </div>
        <p class="se-section-lede"><%= t('stevensed.esign.timestamp_lede') %></p>
        <%= form_for encrypted_config, url: timestamp_server_index_path, method: :post, html: { autocomplete: 'off', class: 'space-y-4 max-w-xl' } do |f| %>
          <div class="form-control">
            <%= f.label :value, t('stevensed.esign.timestamp_url'), class: 'label' %>
            <%= f.url_field :value, autocomplete: 'off', class: 'base-input', placeholder: "URL (#{t('optional')})" %>
          </div>
          <div class="form-control">
            <%= f.button button_title(title: t('save'), disabled_with: t('updating')), class: 'base-button' %>
          </div>
        <% end %>
      </section>
    <% end %>
    <section aria-labelledby="verify_signed_pdf">
      <div class="se-section-head">
        <h2 id="verify_signed_pdf" class="text-2xl font-bold"><%= t('stevensed.esign.verify_heading') %></h2>
      </div>
      <div id="result">
        <p class="se-section-lede"><%= t('stevensed.esign.verify_lede') %></p>
      </div>
      <%= form_for '', url: verify_pdf_signature_index_path, method: :post, html: { enctype: 'multipart/form-data', class: 'max-w-xl' } do |f| %>
        <%= f.button type: 'submit', class: 'flex' do %>
          <div class="disabled mb-3">
            <%= svg_icon('loader', class: 'w-5 h-5 animate-spin inline') %>
            <%= "#{t('analyzing')}..." %>
          </div>
        <% end %>
        <file-dropzone data-name="verify_attachments" data-submit-on-upload="true" class="w-full">
          <label for="file" class="se-dropzone w-full block h-32 relative">
            <div class="absolute top-0 right-0 left-0 bottom-0 flex items-center justify-center p-2">
              <div class="flex flex-col items-center text-center">
                <span data-target="file-dropzone.icon">
                  <%= svg_icon('cloud_upload', class: 'w-10 h-10') %>
                </span>
                <span data-target="file-dropzone.loading" class="hidden">
                  <%= svg_icon('loader', class: 'w-10 h-10 animate-spin') %>
                </span>
                <div class="font-medium mb-1">
                  <%= t('stevensed.esign.verify_action') %>
                </div>
                <div class="text-sm text-base-content/80">
                  <span class="md:hidden"><%= t('click_to_upload') %></span>
                  <span class="hidden md:inline"><%= t('click_to_upload_or_drag_and_drop_files_html') %></span>
                </div>
              </div>
              <input id="file" name="files[]" class="hidden" data-action="change:file-dropzone#onSelectFiles" data-target="file-dropzone.input" type="file" accept="application/pdf" multiple>
            </div>
          </label>
        </file-dropzone>
      <% end %>
    </section>
    <% account_config = AccountConfig.where(account: current_account, key: AccountConfig::ESIGNING_PREFERENCE_KEY).first_or_initialize(value: 'single') %>
    <% if can?(:manage, account_config) %>
      <section aria-labelledby="esign_preferences" class="max-w-xl">
        <div class="se-section-head">
          <h2 id="esign_preferences" class="text-2xl font-bold"><%= t('preferences') %></h2>
        </div>
        <% if can?(:manage, account_config) && (can?(:manage, :personalization_advanced) || account_config.persisted?) %>
          <%= form_for account_config, url: account_configs_path, method: :post do |f| %>
            <%= f.hidden_field :key %>
            <div class="flex items-center justify-between gap-4 py-2.5">
              <span>
                <%= t('apply_multiple_pdf_digital_signatures_in_the_document_per_each_signer') %>
              </span>
              <submit-form data-on="change" class="flex">
                <%= f.check_box :value, { class: 'toggle', checked: account_config.value == 'multiple' }, 'multiple', 'single' %>
              </submit-form>
            </div>
          <% end %>
        <% end %>
        <% account_config = AccountConfig.find_or_initialize_by(account: current_account, key: AccountConfig::FLATTEN_RESULT_PDF_KEY) %>
        <% if can?(:manage, account_config) %>
          <%= form_for account_config, url: account_configs_path, method: :post do |f| %>
            <%= f.hidden_field :key %>
            <div class="flex items-center justify-between gap-4 py-2.5">
              <span>
                <%= t('remove_pdf_form_fillable_fields_from_the_signed_pdf_flatten_form') %>
              </span>
              <submit-form data-on="change" class="flex">
                <%= f.check_box :value, { class: 'toggle', checked: account_config.value != false } %>
              </submit-form>
            </div>
          <% end %>
        <% end %>
        <% account_config = AccountConfig.find_or_initialize_by(account: current_account, key: AccountConfig::DOCUMENT_FILENAME_FORMAT_KEY) %>
        <% if can?(:manage, account_config) %>
          <%= form_for account_config, url: account_configs_path, method: :post do |f| %>
            <%= f.hidden_field :key %>
            <div class="py-2.5">
              <span>
                <%= t('document_download_filename_format') %>
              </span>
              <submit-form data-on="change" class="block mt-3">
                <%= f.select :value, [["#{I18n.t('document_name')}.pdf", '{document.name}'], ["#{I18n.t('document_name')} - #{I18n.t(:signed)}.pdf", '{document.name} - {submission.status}'], ["#{I18n.t('document_name')} - name@domain.com.pdf", '{document.name} - {submission.submitters}'], ["#{I18n.t('document_name')} - name@domain.com - #{I18n.l(Time.current.beginning_of_year.in_time_zone(current_account.timezone), format: :short)}.pdf", '{document.name} - {submission.submitters} - {submission.completed_at}']], {}, class: 'base-select' %>
              </submit-form>
            </div>
          <% end %>
        <% end %>
      </section>
    <% end %>
  </div>
</div>
