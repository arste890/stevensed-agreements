<div class="flex flex-wrap space-y-4 md:flex-nowrap md:space-y-0">
  <%= render 'shared/settings_nav' %>
  <div class="flex-grow max-w-3xl mx-auto">
    <h1 class="text-3xl md:text-4xl font-bold mb-2"><%= t('stevensed.imported_records') %></h1>
    <p class="mb-6 text-base-content/80"><%= t('stevensed.imported_records_intro') %></p>
    <% if @records.blank? %>
      <div class="card bg-base-200 p-6 text-center"><%= t('stevensed.no_imported_records') %></div>
    <% else %>
      <div class="space-y-4">
        <% @records.each do |r| %>
          <div class="bg-base-200 rounded-2xl p-5">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <div class="font-semibold"><%= r.dig('template', 'name') %></div>
              <div class="text-sm text-base-content/70"><%= t('stevensed.completed_on', date: r['completed_at'].to_s.first(10)) %></div>
            </div>
            <div class="text-sm mt-1 text-base-content/80">
              <%= r['submitters'].to_a.map { |s| [s['role'], s['name'].presence || s['email']].compact.join(': ') }.join(' | ') %>
            </div>
            <div class="flex flex-wrap gap-2 mt-3">
              <% r['files'].to_h.each_key do |f| %>
                <a class="btn btn-sm btn-outline" target="_blank" href="<%= settings_imported_record_path(r['dir'], file: f) %>"><%= f.delete_suffix('.pdf') %></a>
              <% end %>
            </div>
            <div class="text-xs mt-2 text-base-content/70">
              <% verified = r['verified_against_audit_log'].to_h %>
              <%= verified.any? && verified.values.all? ? t('stevensed.verified_against_audit') : t('stevensed.not_verified') %> | <%= t('stevensed.original_envelope', id: r['dir']) %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="w-0 lg:w-52"></div>
</div>
