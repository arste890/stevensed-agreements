<div class="flex flex-wrap space-y-4 md:flex-nowrap md:space-y-0">
  <%= render 'shared/settings_nav' %>
  <div class="flex-grow">
    <h1 class="text-3xl md:text-4xl font-bold mb-4"><%= t('stevensed.imported_records') %></h1>
    <p><%= t('stevensed.imported_records_intro') %></p>
    <% if @records.blank? %>
      <p class="se-rows se-row"><%= t('stevensed.no_imported_records') %></p>
    <% else %>
      <ul class="se-rows" role="list">
        <% @records.each do |r| %>
          <% completed_on = record_completed_on(r) %>
          <% verified = r['verified_against_audit_log'].to_h %>
          <% signers = record_signers(r) %>
          <li class="se-row">
            <h2 class="se-row__title"><%= r.dig('template', 'name') %></h2>
            <p class="se-row__meta">
              <%= t('stevensed.completed_on', date: completed_on ? l(completed_on, format: :long) : r['completed_at'].to_s.first(10)) %>
            </p>
            <% if signers.any? %>
              <dl class="se-pairs">
                <% signers.each do |s| %>
                  <dt><%= s['role'] %></dt>
                  <dd>
                    <% if s['name'].present? %>
                      <%= s['name'] %> <span class="se-quiet"><%= s['email'] %></span>
                    <% else %>
                      <%= s['email'] %>
                    <% end %>
                  </dd>
                <% end %>
              </dl>
            <% end %>
            <div class="se-row__actions">
              <% record_downloads(r).each do |d| %>
                <a class="white-button" target="_blank" rel="noopener" href="<%= settings_imported_record_path(r['dir'], file: d[:file]) %>" title="<%= d[:file] %>">
                  <%= svg_icon('download', class: 'w-5 h-5') %>
                  <span><%= d[:label] %></span>
                </a>
              <% end %>
            </div>
            <% if verified.any? && verified.values.all? %>
              <p class="se-note"><%= svg_icon('circle_check', class: 'w-5 h-5') %><span><%= t('stevensed.imported_records_verified', id: r['dir']) %></span></p>
            <% else %>
              <p class="se-note se-note--warn"><%= svg_icon('alert_circle', class: 'w-5 h-5') %><span><%= t('stevensed.imported_records_not_verified', id: r['dir']) %></span></p>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
