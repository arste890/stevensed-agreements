<% document_name = @submitter.submission.name.presence || @submitter.submission.template&.name %>
<% signing = @submitter.with_signature_fields? %>
<% submit_url = submit_form_url(slug: @submitter.slug, t: SubmissionEvents.build_tracking_param(@submitter, 'click_email'), host: @custom_domain || ENV.fetch('EMAIL_HOST', Docuseal.default_url_options[:host])) %>
<% action_label = t(signing ? 'stevensed.email.review_and_sign' : 'stevensed.email.review_and_submit') %>
<% content_for(:preheader, t(signing ? 'stevensed.email.invitation_preheader_sign' : 'stevensed.email.invitation_preheader_submit', name: document_name)) %>
<% content_for(:personal_link_notice) { render 'shared/email_personal_link_notice' } %>
<% if @body.present? %>
  <% append_link = !@body.match?(ReplaceEmailVariables::SUBMITTER_LINK) && !@body.match?(ReplaceEmailVariables::SUBMITTER_ID) && !@body.match?(ReplaceEmailVariables::SUBMISSION_LINK) && !@body.match?(ReplaceEmailVariables::TEMPLATE_ID) && !@submitter.submission.source.in?(%w[api embed]) %>
  <%= render 'custom_body', body: @body, submitter: @submitter, link_url: (submit_url if append_link), link_label: action_label %>
<% else %>
  <%= render 'shared/email_heading', eyebrow: (t('stevensed.email.reminder_eyebrow') if @reminder), title: t(signing ? 'stevensed.email.invitation_title_sign' : 'stevensed.email.invitation_title_submit') %>
  <%= render 'shared/email_greeting', name: @submitter.name %>
  <p><%= t(signing ? 'stevensed.email.invitation_intro_sign_html' : 'stevensed.email.invitation_intro_submit_html', name: document_name, product_name: Stevensed::PRODUCT_NAME, office: Stevensed::OFFICE) %></p>
  <% if @reminder %>
    <p><%= t('stevensed.email.reminder_intro') %></p>
  <% end %>
  <%= render 'shared/email_details', rows: [[t('stevensed.email.document'), document_name], [t('stevensed.email.requested_by'), @submitter.submission.created_by_user&.full_name.presence], [t('stevensed.email.respond_by'), (l(@submitter.submission.expire_at.to_date, format: :long) if @submitter.submission.expire_at)]] %>
  <%= render 'shared/email_button', url: submit_url, label: action_label %>
  <% if signing %>
    <p><%= t('stevensed.email.esign_statement_html', consent_url: 'https://policies.stevensed.org/#/doc/e-signature-consent') %></p>
  <% end %>
  <p><%= t('stevensed.email.questions_html', email: Stevensed::CONTACT_EMAIL) %></p>
<% end %>
