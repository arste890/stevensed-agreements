<% document_name = @submitter.submission.name.presence || @submitter.submission.template&.name %>
<% copy_url = submissions_preview_url(@submitter.submission.slug, { sig: @sig, host: @custom_domain || ENV.fetch('EMAIL_HOST', Docuseal.default_url_options[:host]) }.compact) %>
<% submitters = @submitter.submission.submitters.order(:completed_at).map { |e| e.name || e.email || e.phone }.uniq.join(', ') %>
<% content_for(:preheader, t('stevensed.email.copy_preheader', name: document_name)) %>
<% content_for(:meta) { render 'shared/email_meta', submission: @submitter.submission, account: @current_account } %>
<% content_for(:personal_link_notice) { render 'shared/email_personal_link_notice' } %>
<% if @body.present? %>
  <%= render 'custom_body', body: @body, submitter: @submitter, sig: @sig %>
<% else %>
  <%= render 'shared/email_heading', eyebrow: t('stevensed.email.completed_eyebrow'), tone: :success, title: t('stevensed.email.copy_title', name: document_name) %>
  <%= render 'shared/email_greeting', name: @submitter.name %>
  <p><%= t('stevensed.email.copy_intro') %></p>
  <%= render 'shared/email_details', rows: [[t('stevensed.email.document'), document_name], [t('stevensed.email.signed_by'), submitters], [t('stevensed.email.completed_on'), (l(@submitter.completed_at.in_time_zone(@current_account.timezone), format: :long) if @submitter.completed_at)]] %>
  <% if attachments.any? %>
    <p><%= t('stevensed.email.copy_attached') %></p>
  <% end %>
  <%= render 'shared/email_button', url: copy_url, label: t('stevensed.email.download_copy') %>
  <% if @sig %>
    <p><%= t('stevensed.email.copy_link_expires', duration: SubmitterMailer::SIGN_TTL.inspect) %></p>
  <% end %>
  <p><%= t('stevensed.email.questions_html', email: Stevensed::CONTACT_EMAIL) %></p>
<% end %>
