<% document_name = @submitter.submission.name.presence || @submitter.submission.template&.name %>
<% submitter_name = @submitter.name || @submitter.email || @submitter.phone %>
<% content_for(:preheader, t('stevensed.email.declined_preheader', name: document_name, submitter: submitter_name)) %>
<%= render 'shared/email_heading', eyebrow: t('stevensed.email.declined_eyebrow'), title: t('stevensed.email.declined_title') %>
<%= render 'shared/email_greeting', name: @user&.first_name %>
<p><%= t('stevensed.email.declined_intro_html', name: document_name, submitter: submitter_name) %></p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;margin:4px 0 24px 0;">
  <tr>
    <td class="se-panel" style="background-color:#F7F5F1;border:1px solid #E9E3D8;border-left:3px solid #C13F44;border-radius:4px;padding:16px 20px 0 20px;">
      <p class="se-muted" style="margin:0 0 6px 0;font-size:11px;line-height:16px;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:#59697A;"><%= t('stevensed.email.reason_given') %></p>
      <%= simple_format(h(@submitter.submission_events.find_by(event_type: :decline_form).data['reason']), {}, sanitize: false) %>
    </td>
  </tr>
</table>
<p><%= t('stevensed.email.declined_next_steps') %></p>
<%= render 'shared/email_button', url: submission_url(@submitter.submission), label: t('stevensed.email.view_submission') %>
