<%# StevensED landing page for visitors who are not signed in. %>
<div class="max-w-xl mx-auto px-4 py-16 text-center space-y-8">
  <img src="<%= Stevensed::LOGO_PATH %>" alt="StevensED" class="h-28 w-auto mx-auto">
  <div class="space-y-3">
    <h1 class="text-4xl font-bold"><%= Docuseal.product_name %></h1>
    <p class="text-lg text-base-content/80">Review and sign agreements with StevensED. If you received a signing request, open the link in the email; no account is needed.</p>
  </div>
  <a href="<%= new_user_session_path %>" class="btn btn-neutral text-white px-10"><%= t('sign_in') %></a>
  <p class="text-sm text-base-content/70"><%= Stevensed::OFFICE %> · <a class="underline" href="mailto:<%= Stevensed::CONTACT_EMAIL %>"><%= Stevensed::CONTACT_EMAIL %></a></p>
</div>
<%= render 'shared/attribution' %>
