<%# StevensED: points to the StevensED embedding instructions instead of the upstream upgrade page. %>
<% if !turbo_native_app? && !Docuseal.multitenant? && can?(:manage, AccountConfig) %>
  <div class="alert">
    <%= svg_icon('info_circle', class: 'w-6 h-6') %>
    <div>
      <p class="font-bold">
        <%= t('embedding') %>
      </p>
      <p class="text-gray-700">
        <%= t('stevensed.embedding_settings_hint') %>
        <br>
        <%= link_to t('stevensed.open_embedding_settings'), settings_embedding_index_path, class: 'link font-medium', data: { turbo: false } %>
      </p>
    </div>
  </div>
<% end %>
