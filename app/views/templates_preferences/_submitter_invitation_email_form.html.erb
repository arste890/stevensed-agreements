<%= render layout: 'templates_preferences/email_template_form', locals: { key: AccountConfig::SUBMITTER_INVITATION_EMAIL_KEY } do %>
  <%= form_for @template, url: template_preferences_path(@template), method: :post, html: { autocomplete: 'off', class: 'mt-1' }, data: { close_on_submit: false } do |f| %>
    <%= f.fields_for :preferences, Struct.new(:request_email_enabled).new(@template.preferences['request_email_enabled']) do |ff| %>
      <div class="flex items-center justify-between py-2.5 px-1 mb-2">
        <label for="template_request_email_enabled"><%= t('send_signature_request_email') %></label>
        <submit-form data-on="change" class="flex">
          <%= ff.check_box :request_email_enabled, { checked: ff.object.request_email_enabled != false, class: 'toggle', id: 'template_request_email_enabled' }, 'true', 'false' %>
        </submit-form>
      </div>
    <% end %>
  <% end %>
<% end %>
