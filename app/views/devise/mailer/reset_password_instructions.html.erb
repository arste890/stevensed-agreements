<%# StevensED: the reset link must stay the first href in the message (spec/system/profile_settings_spec.rb). %>
<% content_for(:preheader, t('stevensed.email.reset_preheader')) %>
<% content_for(:personal_link_notice) { render 'shared/email_personal_link_notice', account: true } %>
<%= render 'shared/email_heading', title: t('stevensed.email.reset_title') %>
<%= render 'shared/email_greeting', name: @resource.first_name %>
<p><%= t('stevensed.email.reset_intro', product_name: Stevensed::PRODUCT_NAME) %></p>
<%= render 'shared/email_button', url: edit_password_url(@resource, reset_password_token: @token), label: t('stevensed.email.change_password') %>
<p><%= t('stevensed.email.reset_unchanged') %></p>
<p><%= t('stevensed.email.reset_not_requested_html', email: Stevensed::CONTACT_EMAIL) %></p>
