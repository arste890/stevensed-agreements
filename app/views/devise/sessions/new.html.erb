<%= content_for(:canonical_url, new_user_session_url) %>
<% content_for(:html_title, "#{t('sign_in')} | #{Docuseal.product_name}") %>
<%# StevensED: single sign-on first; email and password for local accounts on request. %>
<% sso = Stevensed::Sso.oidc_enabled? || Stevensed::Sso.saml_enabled? %>
<% password_open = !sso || params[:local].present? || params.dig(:user, :email).present? %>
<% auto_sso = Stevensed::Sso.oidc_enabled? && !password_open && request.get? %>
<% if auto_sso %><% content_for :head do %><script src="/stevensed/sso-redirect.js" defer></script><% end %><% end %>
<%= render 'stevensed/styles' %>
<div class="se">
  <%= render 'stevensed/header' %>
  <main class="se-wrap">
    <div class="se-signin">
      <h1 class="se-serif"><%= t('sign_in') %></h1>
      <% if sso %>
        <p class="se-signin-lede"><%= auto_sso ? t('stevensed.redirecting_to_sso') : t('stevensed.sign_in_lede') %></p>
        <div class="se-signin-actions">
          <% if Stevensed::Sso.oidc_enabled? %>
            <%= button_to '/auth/stevensed', method: :post, data: { turbo: false }, class: 'se-btn se-btn-block', form_class: 'se-contents', form: { id: 'se-sso-form' } do %>
              <%= svg_icon('login') %><span><%= t('stevensed.sign_in_with_stevensed') %></span>
            <% end %>
          <% end %>
          <% if Stevensed::Sso.saml_enabled? %>
            <%= button_to '/auth/saml', method: :post, data: { turbo: false }, class: 'se-btn se-btn-quiet se-btn-block', form_class: 'se-contents' do %>
              <span><%= t('stevensed.sign_in_with_saml') %></span>
            <% end %>
          <% end %>
        </div>
      <% end %>
      <%= tag.details class: 'se-local', open: password_open do %>
        <% if sso %>
          <summary><%= t('stevensed.use_password_instead') %></summary>
        <% end %>
        <%= form_for(resource, as: resource_name, html: { class: 'space-y-5 se-local-form' }, data: { turbo: params[:redir].blank? }, url: session_path(resource_name)) do |f| %>
          <%= render 'hidden_fields' %>
          <div class="space-y-2" dir="auto">
            <div class="form-control">
              <%= f.label :email, t(:email), class: 'label' %>
              <%= f.email_field :email, autofocus: !sso, autocomplete: 'email', class: 'base-input' %>
            </div>
            <div class="form-control">
              <%= f.label :password, t(:password), class: 'label' %>
              <%= f.password_field :password, autocomplete: 'current-password', class: 'base-input' %>
            </div>
          </div>
          <div class="form-control">
            <%= f.button button_title(title: t(:sign_in), disabled_with: t(:signing_in)), class: 'base-button' %>
          </div>
          <%= render 'extra_links' %>
          <%= render 'devise/shared/links' %>
        <% end %>
      <% end %>
      <p class="se-signin-note"><%= t('stevensed.signing_request_note') %></p>
    </div>
  </main>
  <%= render 'stevensed/footer' %>
</div>
